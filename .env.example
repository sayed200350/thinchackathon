# Kopieren nach .env und ausfüllen. .env nie committen.
# Reviewer backend uses this URL and the project's publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only overrides for the generated private evidence and staff keys.
# Set each to a different random value of at least 32 characters when using overrides.
# Leave these lines commented to use generated keys. Never add them to the Lovable client.
# CLAIM_EVIDENCE_SERVICE_KEY=
# CLAIM_REVIEWER_KEY=
# Origin of the garage-only gateway, reachable from a judge's phone.
# GARAGE_PUBLIC_ORIGIN=https://garage.example.org
# Optional stable server-only secret for garage links (at least 32 random characters).
# CLAIM_GARAGE_KEY=
# Optional local reviewer-chat integrations. Keep these keys on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JEV_API_KEY=
JEV_MODEL=jev-latest

# Optional policy adaptation workbench settings.
AI_API_KEY=
# disabled, gemini or openai_compatible (provider must support JSON schema)
AI_PROVIDER=disabled
# Explicit provider API root, including its version path; no automatic inference
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
POLICY_TWIN_OWNER_TOKEN=
POLICY_TWIN_OWNER_NAME=Policy owner
