# Server-only. Copy to .env and fill locally. Existing environment values win.
AI_API_KEY=
# disabled, gemini or openai_compatible (provider must support JSON schema)
AI_PROVIDER=disabled
# Explicit provider API root, including its version path; no automatic inference
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
POLICY_TWIN_OWNER_TOKEN=
POLICY_TWIN_OWNER_NAME=Policy owner
