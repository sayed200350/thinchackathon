# Kopieren nach .env und ausfüllen. .env nie committen.
# Reviewer backend uses this URL and the project's publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local reviewer-chat integrations. Keep these keys on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JEV_API_KEY=
JEV_MODEL=jev-latest

# Optional browser voice demo. Enable after configuring the ElevenLabs webhook.
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
CLAIM_PUBLIC_ORIGIN=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_FROM=
VOICE_DEMO_PHONE=
