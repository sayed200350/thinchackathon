# Kopieren nach .env und ausfüllen. .env nie committen.
# Reviewer backend uses this URL and the project's publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only overrides for the generated private evidence and staff keys.
# Set each to a different random value of at least 32 characters when using overrides.
# Leave these lines commented to use generated keys. Never add them to the Lovable client.
# CLAIM_EVIDENCE_SERVICE_KEY=
# CLAIM_REVIEWER_KEY=
# Optional local reviewer-chat integrations. Keep these keys on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JEV_API_KEY=
JEV_MODEL=jev-latest
